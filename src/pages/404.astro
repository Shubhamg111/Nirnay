---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Nirnay" description="This page doesn't exist." noindex={true}>
  <div class="text-center py-20">
    <p class="font-mono text-xs tracking-widest uppercase text-brass mb-4">404</p>
    <h1 class="font-display text-3xl font-semibold mb-4">This trail doesn't exist</h1>
    <p class="text-ink/60 mb-8">The page you're looking for may have moved or never existed.</p>
    <a href="/" class="font-mono text-sm text-brass hover:underline">← Back to homepage</a>
  </div>
</BaseLayout>
