---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContourDivider from '../components/ContourDivider.astro';
import { getCollection } from 'astro:content';
import { categoryColorClass, SECTIONS } from '../lib/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const milestones = [
  { x: 20, y: 150, label: 'Start' },
  { x: 110, y: 120, label: 'Research' },
  { x: 210, y: 95, label: 'Compare options' },
  { x: 320, y: 55, label: 'Decide' },
  { x: 430, y: 30, label: 'Use it well' },
  { x: 540, y: 10, label: 'Level up' },
];
const linePath = milestones.map((m, i) => `${i === 0 ? 'M' : 'L'}${m.x},${m.y}`).join(' ');
const fillPath = `${linePath} L${milestones[milestones.length - 1].x},170 L${milestones[0].x},170 Z`;
---

<BaseLayout
  title="NirnayBlogs — Money, Tech & Gadgets Blogs"
  description="Plain-language guides on stock and mutual funds, AI tools and software, and phones and gadgets in Nepal — plus free calculators and comparisons to help you decide."
>
  <section class="mb-6">
    <p class="font-mono text-xs tracking-widest uppercase text-brass mb-4">Money, tech, and gadgets — mapped like a trail</p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-tight max-w-2xl">
      Good decisions are a route, not a leap.
    </h1>
    <p class="text-ink/70 mt-4 max-w-xl text-lg">
      Guides on NEPSE, mutual funds, AI tools, software, phones, and gadgets — plus tools to help you plan your own next step.
    </p>
  </section>

  <section class="mb-14 -mx-6 sm:mx-0">
    <div class="bg-paper border border-line rounded-sm px-4 sm:px-8 pt-8 pb-4 overflow-x-auto">
      <svg viewBox="0 0 580 190" class="w-full min-w-[560px] h-auto" aria-labelledby="chartTitle">
        <title id="chartTitle">Illustrative path from starting to research to a confident, informed decision</title>
        <line x1="0" y1="170" x2="580" y2="170" stroke="#C7CFC7" stroke-width="1" />
        <path d={fillPath} fill="#A9812E" fill-opacity="0.08" />
        <path d={linePath} fill="none" stroke="#A9812E" stroke-width="2" />
        {milestones.map((m) => (
          <g>
            <circle cx={m.x} cy={m.y} r="4" fill="#16211C" />
            <text x={m.x} y={m.y - 14} text-anchor="middle" class="font-mono" font-size="10" fill="#16211C" opacity="0.75">
              {m.label}
            </text>
          </g>
        ))}
      </svg>
      <p class="font-mono text-xs text-ink/40 mt-2">Illustrative only — one path, any topic.</p>
    </div>
  </section>

  <ContourDivider />

  <section class="mt-10 mb-14">
    <h2 class="font-display text-2xl font-semibold mb-6">Browse by section</h2>
    <div class="grid sm:grid-cols-3 gap-4">
      {Object.entries(SECTIONS).map(([key, s]) => (
        <a href={`/blog/${key}`} class="block bg-paper border border-line rounded-sm p-5 hover:border-current transition-colors">
          <span class={`font-mono text-[11px] tracking-wide uppercase ${s.color}`}>{s.label}</span>
          <p class="text-ink/60 text-sm mt-2">
            {key === 'finance' && 'NEPSE, mutual funds, real estate, and personal finance.'}
            {key === 'tech' && 'Software, AI tools, programming, and apps.'}
            {key === 'gadgets' && 'Reviews, buying guides, and comparisons.'}
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="font-display text-2xl font-semibold">Latest posts</h2>
      <a href="/blog" class="text-sm font-medium text-brass hover:underline">View all →</a>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      {posts.map((post) => (
        <a href={`/blog/${post.data.section}/${post.slug}`} class="group block bg-paper border border-line rounded-sm p-5 hover:border-brass transition-colors">
          <span class={`font-mono text-[11px] tracking-wide uppercase ${categoryColorClass(post.data.category)}`}>
            {post.data.category}
          </span>
          <h3 class="font-display text-lg font-semibold mt-2 leading-snug group-hover:text-brass transition-colors">
            {post.data.title}
          </h3>
          <p class="text-ink/60 text-sm mt-2">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>