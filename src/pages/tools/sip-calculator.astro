---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SipCalculator from '../../components/calculators/SipCalculator.jsx';
---

<BaseLayout
  title="SIP Calculator | Nirnay"
  description="Estimate the maturity value of a monthly SIP investment in mutual funds or NEPSE stocks."
>
  <p class="font-mono text-xs tracking-widest uppercase text-brass mb-3">Tools</p>
  <h1 class="font-display text-3xl font-semibold mb-2">SIP calculator</h1>
  <p class="text-ink/60 mb-6 max-w-xl">
    See how a fixed monthly investment could grow over time with compounding.
  </p>
  <SipCalculator client:load />
</BaseLayout>
