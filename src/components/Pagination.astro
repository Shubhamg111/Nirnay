---
import type { Page } from 'astro';

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;
---

{page.lastPage > 1 && (
  <nav class="flex items-center justify-between mt-12 pt-6 border-t border-line" aria-label="Pagination">
    {page.url.prev ? (
      <a href={page.url.prev} class="font-mono text-sm text-brass hover:underline">← Newer</a>
    ) : <span />}

    <span class="font-mono text-xs text-ink/50">
      Page {page.currentPage} of {page.lastPage}
    </span>

    {page.url.next ? (
      <a href={page.url.next} class="font-mono text-sm text-brass hover:underline">Older →</a>
    ) : <span />}
  </nav>
)}